{
  "name": "pcb-copilot",
  "version": "3.0.0",
  "private": true,
  "description": "Turn a plain-English engineering brief into a verified, manufacturable tscircuit PCB design.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:golden": "vitest run tests/golden",
    "golden:hash": "tsx scripts/golden-hash.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "probe:exports": "tsx scripts/probes/exports.ts",
    "probe:sandbox": "tsx scripts/probes/sandbox.ts",
    "probe:all": "pnpm run probe:sandbox && pnpm run probe:exports",
    "build:assets": "tsx scripts/build-icons.ts && tsx scripts/render-zero-sheet.ts /tmp/zero-states.png",
    "knowledge:build": "tsx scripts/build-knowledge-index.ts",
    "golden:verify": "vitest run tests/golden",
    "eval": "tsx --env-file-if-exists=.env.local evals/run.ts",
    "verify:secrets": "node scripts/verify-no-secrets.mjs",
    "prepare": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@tscircuit/3d-viewer": "0.0.598",
    "@tscircuit/checks": "0.0.191",
    "@tscircuit/eval": "0.0.1401",
    "@tscircuit/pcb-viewer": "1.11.394",
    "@tscircuit/schematic-viewer": "2.0.92",
    "@vercel/analytics": "1.6.1",
    "circuit-json": "0.0.490",
    "circuit-json-to-bom-csv": "0.0.17",
    "circuit-json-to-gerber": "0.0.106",
    "circuit-json-to-pnp-csv": "0.0.13",
    "clsx": "2.1.1",
    "jszip": "3.10.2",
    "lucide-react": "1.17.0",
    "minisearch": "7.1.2",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "3.13.0",
    "tailwind-merge": "3.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@tscircuit/props": "0.0.656",
    "@types/node": "24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "3.2.4",
    "axe-core": "^4.13.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "6.1.1",
    "globals": "16.5.0",
    "jsdom": "27.0.0",
    "msw": "2.12.4",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  }
}
