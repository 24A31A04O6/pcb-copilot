# ---------------------------------------------------------------------------
# pcb-copilot environment
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; CI asserts it stays
# untracked (scripts/verify-no-secrets.mjs). Every value below is read on the server only.
# Nothing in this file is ever sent to the browser: there is no NEXT_PUBLIC_ variable here
# on purpose, because there is no configuration the browser needs.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Fireworks API key. Server-side only; the client never receives it, and it is never
# written to a log line. Get one at https://fireworks.ai/api-keys
FIREWORKS_API_KEY=replace-with-your-fireworks-key

# --- Model selection (optional) ---------------------------------------------

# Fully pinned Fireworks model path. Moving aliases such as `*-latest` are rejected on
# purpose: a silent model swap changes every design the app produces.
# Default: accounts/fireworks/models/glm-5p3-flash
# FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3-flash

# Second model, used only when the first one is unavailable or unusable. It is never used
# for a design that merely failed to parse; that gets a schema-repair call instead.
# Default: accounts/fireworks/models/deepseek-v4p1-flash
# FIREWORKS_FALLBACK_MODEL=accounts/fireworks/models/deepseek-v4p1-flash

# The fallback is opt-in. Set to 1 to enable it.
# ALLOW_FALLBACK_MODEL=1

# Base URL for the inference API. Only change this to point at a compatible gateway.
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# --- Cost and latency budgets (optional) ------------------------------------

# Hard ceiling on one model call. 5,000-180,000, default 60,000.
# FIREWORKS_TIMEOUT_MS=60000

# Output token budget for the code-generation stage. 1,000-32,000, default 8,000.
# This is the number that decides whether a big board truncates: `finish_reason: length`
# is reported as a truncation, never as a successful design.
# FIREWORKS_CODEGEN_MAX_TOKENS=8000

# --- Compilation sandbox (optional) -----------------------------------------

# Wall-clock limit for one tscircuit compile. 5,000-120,000, default 30,000.
# COMPILE_TIMEOUT_MS=30000

# Memory cap for the compile worker. 128-2,048, default 768. Raise it only if a large
# board legitimately needs it; it is the main defence against a runaway design.
# COMPILE_MEMORY_MB=768

# --- Rate limiting (optional) ------------------------------------------------

# Upstash Redis REST credentials. Without them, rate limiting falls back to an in-process
# counter, which is per-instance: correct on one box, not correct behind a load balancer.
# Set BOTH or neither.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token

# --- Bot protection (optional) ----------------------------------------------

# Cloudflare Turnstile. When the secret is set, the design endpoint requires a token from
# the widget; when it is absent, the endpoint is unprotected and says so in /api/health.
# TURNSTILE_SITE_KEY=0x4AAAAAAA-replace-with-site-key
# TURNSTILE_SECRET_KEY=replace-with-turnstile-secret

# --- Observability (optional) ------------------------------------------------

# Sentry DSN. When set, server errors are reported; the API key is never attached.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- Retrieval and tools (optional) ------------------------------------------

# Part search. OFF unless WEB_SEARCH_ENABLED=1 AND PART_SEARCH_URL is set, and the model is
# told so explicitly either way rather than being left to guess. See docs/DECISIONS.md §6.
#
# There is no open, self-serve electronic-parts API a serverless function can rely on:
# SnapMagic sells its Search API by request and does not publish the contract, and
# Octopart/Nexar requires an approved application. The endpoint is therefore yours to
# supply. The contract is the smallest one any HTTP JSON search can satisfy:
#
#   GET {PART_SEARCH_URL}?q={query}&limit={1..10}
#   -> 200 { "results": [ { "mpn": "LM358DR", "manufacturer": "TI",
#                           "package": "SOIC-8", "footprint": "soic8",
#                           "available": 12400, "unitPriceUsd": 0.24 } ] }
#
#  is the only required field. A response without a "results" array, or a non-2xx
# status, raises PART_SEARCH_UNAVAILABLE and the design is flagged as unverified rather
# than being given a plausible-looking empty answer.
# WEB_SEARCH_ENABLED=1
# WEB_SEARCH_API_KEY=replace-with-your-search-key
# PART_SEARCH_URL=https://your-parts-backend.example/v1/search
